<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#607D94</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:windowBackground">#F2F5F9</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#607D94</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
    </style>
</resources>
